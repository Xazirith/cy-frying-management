{
    auto_https off
}

# Service subdomains
http://registry.sentrasys.dev {
    reverse_proxy registry:8081 sentra-registry:8081
}

http://dns.sentrasys.dev {
    reverse_proxy dns:8084 sentra-dns:8084
}

http://auth.sentrasys.dev {
    reverse_proxy auth:8082 sentra-auth:8082
}

http://deploy.sentrasys.dev {
    reverse_proxy deploy:8083 sentra-deploy:8083
}

http://metrics.sentrasys.dev {
    reverse_proxy metrics:8087 sentra-metrics:8087
}

http://telemetry.sentrasys.dev {
    reverse_proxy telemetry:8085 sentra-telemetry:8085
}

http://vpn.sentrasys.dev {
    reverse_proxy vpn:8086 sentra-vpn:8086
}

http://tenants.sentrasys.dev {
    reverse_proxy tenants:8088 sentra-tenants:8088
}

http://gallery.sentrasys.dev {
    reverse_proxy gallery:8090 sentra-gallery:8090
}

http://dash.sentrasys.dev {
    reverse_proxy dash:80 sentra-dash:80
}

http://core.sentrasys.dev {
    # Allow core to run on either 65085 (prod) or 8000 (dev), and on either hostname.
    reverse_proxy core:65085 core:8000 sentra-core:65085 sentra-core:8000
}

# Default - dashboard, but route APIs to their services
http://sentrasys.dev {
    @appver path /api/app/version*
    reverse_proxy @appver core:65085 core:8000 sentra-core:65085 sentra-core:8000

    @auth path /api/auth*
    reverse_proxy @auth auth:8082 sentra-auth:8082

    @gallery path /api/gallery*
    reverse_proxy @gallery gallery:8090 sentra-gallery:8090

    @app path /api/app*
    reverse_proxy @app gallery:8090 sentra-gallery:8090

    @repo path /api/sentra-repo*
    reverse_proxy @repo core:65085 core:8000 sentra-core:65085 sentra-core:8000

    @admin path /api/admin*
    reverse_proxy @admin core:65085 core:8000 sentra-core:65085 sentra-core:8000

    @tenants path /api/tenants*
    reverse_proxy @tenants tenants:8088 sentra-tenants:8088

    reverse_proxy dash:80 sentra-dash:80
}

http://signage.sentrasys.dev {
    reverse_proxy signage:8095 sentra-signage:8095
}

http://inventree.sentrasys.dev {
    reverse_proxy inventree-proxy:80
}
