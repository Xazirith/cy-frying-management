    reverse_proxy sentra-core:65085
}

# Default - dashboard, but route APIs to their services
http://sentrasys.dev {
    @auth path /api/auth*
    reverse_proxy @auth sentra-auth:8082

    @gallery path /api/gallery*
    reverse_proxy @gallery sentra-gallery:8090

    @app path /api/app*
    reverse_proxy @app sentra-gallery:8090

    @repo path /api/sentra-repo*
    reverse_proxy @repo sentra-core:65085

    @admin path /api/admin*
    reverse_proxy @admin sentra-core:65085

    @tenants path /api/tenants*
    reverse_proxy @tenants sentra-core-sentra-tenants-1:8088

    reverse_proxy sentra-dash:80
}

http://signage.sentrasys.dev {
    reverse_proxy sentra-signage:8095
}

http://inventree.sentrasys.dev {
    reverse_proxy inventree-proxy:80
}
